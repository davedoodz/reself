{
  "expo": {
    "name": "RE:SELF",
    "slug": "reself",
    "scheme": "reself",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F0F9FF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "design.davidlafond.reself",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "RE:SELF records your spoken journal entries. Audio stays on this device."
      }
    },
    "android": {
      "package": "design.davidlafond.reself",
      "permissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#F0F9FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "RE:SELF records your spoken journal entries. Audio stays on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
